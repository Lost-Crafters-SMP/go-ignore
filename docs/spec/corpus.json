{
  "schema": 1,
  "origin": "Project-authored behavioural cases, not copied matcher code or upstream test tables",
  "cases": [
    {"id":"suffix-hit","files":{".gitignore":"*.log\n"},"query":{"Path":"nested/a.log","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"*.log"}},
    {"id":"negation-winner","files":{".gitignore":"*.log\n!keep.log\n"},"query":{"Path":"keep.log","IsDir":false},"expected":{"Ignored":false,"Source":".gitignore","Line":2,"Pattern":"!keep.log"}},
    {"id":"last-line","files":{".gitignore":"target\n!target\ntarget\n"},"query":{"Path":"target","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":3,"Pattern":"target"}},
    {"id":"leading-comment-byte","files":{".gitignore":"#comment\n"},"query":{"Path":"comment","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"spaces-live-empty","files":{".gitignore":"   \n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":""}},
    {"id":"spaces-file-no-match","files":{".gitignore":"   \n"},"query":{"Path":"file","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"blank-not-live","files":{".gitignore":"\n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"negative-empty","files":{".gitignore":"!\n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":false,"Source":".gitignore","Line":1,"Pattern":"!"}},
    {"id":"space-then-negative","files":{".gitignore":"   \n!\n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":false,"Source":".gitignore","Line":2,"Pattern":"!"}},
    {"id":"negative-then-space","files":{".gitignore":"!\n   \n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":2,"Pattern":""}},
    {"id":"slash-empty-directory-rule","files":{".gitignore":"/\n"},"query":{"Path":"directory","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"/"}},
    {"id":"root-anchor","files":{".gitignore":"/target\n"},"query":{"Path":"nested/target","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"basename-at-depth","files":{".gitignore":"target\n"},"query":{"Path":"nested/target","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"target"}},
    {"id":"directory-only-file","files":{".gitignore":"target/\n"},"query":{"Path":"target","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"directory-only-directory","files":{".gitignore":"target/\n"},"query":{"Path":"target","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"target/"}},
    {"id":"blocking-ancestor","files":{".gitignore":"doc/\n!doc/keep\n"},"query":{"Path":"doc/keep","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"doc/"},"block":{"Directory":"doc","Source":".gitignore","Line":1,"Pattern":"doc/"}},
    {"id":"nested-negation","files":{".gitignore":"*.tmp\n","a/.gitignore":"!keep.tmp\n"},"query":{"Path":"a/keep.tmp","IsDir":false},"expected":{"Ignored":false,"Source":"a/.gitignore","Line":1,"Pattern":"!keep.tmp"}},
    {"id":"own-file-slash-endpoint","files":{"a/.gitignore":"*\n"},"query":{"Path":"a","IsDir":true},"expected":{"Ignored":true,"Source":"a/.gitignore","Line":1,"Pattern":"*"}},
    {"id":"escaped-separator","files":{".gitignore":"foo\\/bar\n"},"query":{"Path":"foo/bar","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"foo\\/bar"}},
    {"id":"class-with-slash","files":{".gitignore":"a[b/c]d\n"},"query":{"Path":"abd","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"a[b/c]d"}},
    {"id":"class-cannot-separate","files":{".gitignore":"a[b/c]d\n"},"query":{"Path":"a/d","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"embedded-star-context","files":{".gitignore":"foo**/bar\n"},"query":{"Path":"foobar","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}},
    {"id":"embedded-star-hit","files":{".gitignore":"foo**/bar\n"},"query":{"Path":"foox/bar","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"foo**/bar"}},
    {"id":"zero-directory-span","files":{".gitignore":"a/**/b\n"},"query":{"Path":"a/b","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"a/**/b"}},
    {"id":"directory-slash-endpoint","files":{".gitignore":"d/**\n"},"query":{"Path":"d","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"d/**"}},
    {"id":"directory-provenance-short-prefix","files":{".gitignore":"e/f\ne/**\n"},"query":{"Path":"e/f","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":2,"Pattern":"e/**"}},
    {"id":"directory-provenance-longer-prefix","files":{".gitignore":"e8/f\ne8/**\n"},"query":{"Path":"e8/f","IsDir":true},"expected":{"Ignored":true,"Source":".gitignore","Line":2,"Pattern":"e8/**"}},
    {"id":"malformed-later-rule-active","files":{".gitignore":"bad[\nlive\n"},"query":{"Path":"live","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":2,"Pattern":"live"}},
    {"id":"bom-crlf-line-number","files":{".gitignore":"\ufeff#comment\r\n*.log\r\n"},"query":{"Path":"a.log","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":2,"Pattern":"*.log"}},
    {"id":"ascii-class","files":{".gitignore":"[[:digit:]]x\n"},"query":{"Path":"5x","IsDir":false},"expected":{"Ignored":true,"Source":".gitignore","Line":1,"Pattern":"[[:digit:]]x"}},
    {"id":"case-sensitive","files":{".gitignore":"UPPER\n"},"query":{"Path":"upper","IsDir":false},"expected":{"Ignored":false,"Source":"","Line":0,"Pattern":""}}
  ]
}
